# Target repos — cloned at runtime, never committed
target/*

# Scan results
scans/*

# Linked post-audit remediation bundles
remediations/*

# Ephemeral agent workspace
work/*

# codegraph index (generated by setup-codegraph.sh, never committed)
.codegraph/

# Installed binaries
bins/*
!bins/.gitkeep

# OSV database — downloaded by fetch-osv-db.sh, never committed
.harness/osv-db/

.harness/

# Harness internal state and logs
.harness/logs/*
.harness/cache/*
.harness/tmp/*
.harness/home/*
.harness/config/*
.harness/data/*
!.harness/logs/.gitkeep
!.harness/cache/.gitkeep

# Scan outputs — tracked in git for audit trail, but ignore temp files
scans/**/*.tmp
scans/**/*.lock
remediations/**/*.tmp
remediations/**/*.lock

# OS / editor
.DS_Store
*.swp
*.swo
*~
codedb.snapshot
__pycache__/
*.pyc

# Local
.env
.cate

# Config
config.toml

# Offline pack output (large tarball — ~500 MB, never commit)
vulnops-offline-*.tar.gz

# Platform-namespaced offline pack chunks may be committed for Git transport
!offline/
!offline/*/
!offline/*/offline-pack-chunks.json
!offline/*/*.part-*
