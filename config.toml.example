# vulnops harness — centralized configuration
# Single source of truth for LLM endpoints, API keys, and tool settings.
# Run `bash scripts/load-config.sh` to export env vars from this file.

# ── LLM Provider ──────────────────────────────────────────────────────
[llm]
# OpenAI-compatible gateway endpoint (used by OMP and agent prompts)
# Any URL reachable by the harness — local (http://localhost:8080/v1) or remote.
base_url = ""

# API key — empty string if no auth required
api_key = ""

# OMP model selector used by discovery, validation, and all non-verifier roles.
selector = "openai-codex/gpt-5.5:xhigh"

# Model ID retained only for custom-provider metadata consistency.
model = "gpt-5.5:xhigh"

# Independent verification may use a different model/provider. Empty inherits
# llm.selector.
[llm.verification]
selector = ""

# Provider metadata (used by scripts/bootstrap-omp.sh to generate
# .harness/home/.omp/agent/models.yml)
[llm.provider]
name = "on-prem"
# api: authentication protocol for the endpoint
#   "openai-completions" — standard OpenAI /v1/chat/completions
api = "openai-completions"
# auth: credential mechanism
auth = "api-key"
#   "api-key" — sends Authorization: Bearer <api_key>
# discovery: how to enumerate available models from the endpoint
#   "proxy"    — auto-discovers models via GET /v1/models (requires endpoint support)
#   "explicit" — uses [[llm.provider.models]] entries only (no /v1/models call)
discovery = "proxy"

# When the endpoint lacks /v1/models (discovery = "explicit"), you can pin
# individual models here. context_window / max_tokens are optional and not
# enforced by the harness; pin them only when the endpoint requires it.
# [[llm.provider.models]]
# id = "your-model-name"
# name = "On-Prem Model"

# ── Harness scan settings ─────────────────────────────────────────────
[harness]
# default_depth: scan intensity level
#   "quick"     — 12 hunt tasks, 1 gapfill round
#   "balanced"  — 32 hunt tasks, 2 gapfill rounds
#   "full"      — 64 hunt tasks, 3 gapfill rounds
default_depth = "balanced"

[harness.scans.sast]
# Maximum UTF-8 size of the architecture/evidence packet injected into one
# hunter. Agents may read additional source through tools.
context_packet_bytes = 65536

[harness.scans.sast.budget.quick]
max_hunt_tasks = 12
max_gapfill_rounds = 1
max_attempts = 2

[harness.scans.sast.budget.balanced]
max_hunt_tasks = 32
max_gapfill_rounds = 2
max_attempts = 2

[harness.scans.sast.budget.full]
max_hunt_tasks = 64
max_gapfill_rounds = 3
max_attempts = 2

# Safe reproduction is config-only and off by default. When enabled, target
# code may run only through the fail-closed disposable sandbox wrapper.
[harness.reproduction]
mode = "off" # off | safe
sandbox = "auto" # auto | bubblewrap
timeout_seconds = 120
cpu_seconds = 60
memory_mb = 1024
max_processes = 64
max_output_kb = 256
max_parallel = 1
# Sanitized regression tests and draft patches are retained under the run.
# Exact proof tokens and raw command output are never rendered into reports.
