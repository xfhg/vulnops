# vulnops harness — centralized configuration
# Single source of truth for LLM endpoints, API keys, and tool settings.
# Run `bash scripts/load-config.sh` to export env vars from this file.

# ── LLM Provider ──────────────────────────────────────────────────────
[llm]
# OpenAI-compatible gateway endpoint (used by OMP and agent prompts)
# Any URL reachable by the harness — local (http://localhost:8080/v1) or remote.
base_url = ""

# API key — empty string if no auth required
api_key = ""

# Every model-owned actor has an explicit provider/model:effort route.
# Keep OMP sign-in: Astra handles investigation/review; GPT-6.1 Sol handles the rest.
# All routes retain High reasoning. Daybreak access remains account-controlled.
[llm.routing]
audit_lead = "openai-codex/gpt-6.1-sol:high"
recon = "openai-codex/gpt-6.1-sol:high"
sast = "openai-codex/gpt-6-astra:high"
campaign_planning = "openai-codex/gpt-6-astra:high"
intrusion = "openai-codex/gpt-6-astra:high"
synthesis = "openai-codex/gpt-6-astra:high"
final_verification = "openai-codex/gpt-6-astra:high"
reproduction = "openai-codex/gpt-6-astra:high"
remediation = "openai-codex/gpt-6.1-sol:high"
advantage_lead = "openai-codex/gpt-6.1-sol:high"
advantage = "openai-codex/gpt-6-astra:high"
advantage_verification = "openai-codex/gpt-6-astra:high"

# Provider metadata (used by scripts/bootstrap-omp.sh to generate
# .harness/home/.omp/agent/models.yml)
[llm.provider]
name = "on-prem"
# api: authentication protocol for the endpoint
#   "openai-completions" — standard OpenAI /v1/chat/completions
api = "openai-completions"
# auth: credential mechanism
auth = "api-key"
#   "api-key" — sends Authorization: Bearer <api_key>
# discovery: how to enumerate available models from the endpoint
#   "proxy"    — auto-discovers models via GET /v1/models (requires endpoint support)
#   "explicit" — uses [[llm.provider.models]] entries only (no /v1/models call)
discovery = "proxy"

# When the endpoint lacks /v1/models (discovery = "explicit"), you can pin
# individual models here. context_window / max_tokens are optional and not
# enforced by the harness; pin them only when the endpoint requires it.
# [[llm.provider.models]]
# id = "your-model-name"
# name = "On-Prem Model"

# ── Harness scan settings ─────────────────────────────────────────────
[harness]
# default_depth: scan intensity level
#   "quick"     — 12 hunt tasks / 24 questions, 1 gapfill round
#   "balanced"  — 32 hunt tasks / 64 questions, 2 gapfill rounds
#   "full"      — 64 hunt tasks / 128 questions, 3 gapfill rounds
default_depth = "balanced"

[harness.network]
# Network behavior is runtime configuration, independent of package format.
# policy_only has no harness-level egress sandbox and requires no Bubblewrap.
linux_agent_egress = "policy_only" # enforced | policy_only

# Optional exact-content review of a requirements-named non-dependency document.
# Only enable after source inspection; changed bytes are scanned again.
# Reasons are published with coverage limitations: never include secrets.
# [[harness.scans.reviewed_non_dependency_requirements]]
# path = "repository/docs/requirements.txt"
# sha256 = "<lowercase-sha256-of-the-reviewed-file>"
# reason = "Reviewed business requirements, not a Python dependency manifest."

[harness.scans.recon.timeout_seconds]
# End-to-end phase deadlines, including all workers and coordinator validation.
# Effective deadline is max(this value, 900 + 300 * (repository_count - 1)).
quick = 1800
balanced = 2700
full = 5400

[harness.scans.sast]
# Maximum UTF-8 size of one exact contextual hunt packet. Adjacent source work
# must be returned as a bounded rabbit hole rather than widening the packet.
context_packet_bytes = 65536

[harness.scans.sast.budget.quick]
max_hunt_tasks = 12
max_hunt_questions = 24
max_gapfill_rounds = 1
max_attempts = 2

[harness.scans.sast.budget.balanced]
max_hunt_tasks = 32
max_hunt_questions = 64
max_gapfill_rounds = 2
max_attempts = 2

[harness.scans.sast.budget.full]
max_hunt_tasks = 64
max_hunt_questions = 128
max_gapfill_rounds = 3
max_attempts = 2

[harness.scans.gap_exploration]
enabled = true

# Advantage is explicitly launched; allocations are global across deep passes.
# Each continuation consumes one task and one question allocation.
[harness.advantage]
max_attempts = 2

[harness.advantage.budget.quick]
deep_passes = 2
max_tasks = 12
max_questions = 24
max_concurrency = 4
max_continuation_rounds = 1
max_continuation_tasks = 4
phase_timeout_seconds = 1800

[harness.advantage.budget.balanced]
deep_passes = 3
max_tasks = 32
max_questions = 64
max_concurrency = 8
max_continuation_rounds = 2
max_continuation_tasks = 12
phase_timeout_seconds = 3600

[harness.advantage.budget.full]
deep_passes = 4
max_tasks = 64
max_questions = 128
max_concurrency = 12
max_continuation_rounds = 3
max_continuation_tasks = 24
phase_timeout_seconds = 7200

# Safe reproduction is config-only and off by default. When enabled, target
# code may run only through the fail-closed disposable sandbox wrapper.
[harness.reproduction]
# Bubblewrap is optional and required only when safe reproduction is selected.
mode = "off" # off | safe
sandbox = "auto" # auto | bubblewrap
timeout_seconds = 120
cpu_seconds = 60
memory_mb = 1024
max_processes = 64
max_output_kb = 256
max_parallel = 1
# Sanitized regression tests and draft patches are retained under the run.
# Exact proof tokens and raw command output are never rendered into reports.
