{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnops.local/schemas/secrets-redacted-candidates.schema.json",
  "title": "VulnOps Secrets Redacted Candidates",
  "type": "object",
  "required": ["schema_version", "tool", "candidates"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "tool": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "classification", "severity", "file", "line", "redacted_value", "evidence_refs", "raw_ref", "source"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "classification": {"type": "string", "enum": ["confirmed", "likely", "false-positive", "deprecated", "candidate"]},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "redacted_value": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "raw_ref": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    }
  }
}
