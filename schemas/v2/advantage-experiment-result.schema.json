{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advantage linked experiment-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "owner_phase",
    "request_ref",
    "request_sha256",
    "status",
    "sandbox",
    "exit_code",
    "limits",
    "resolution",
    "interpretation_boundary",
    "execution_kind",
    "owner_id",
    "question_id",
    "source_view",
    "baseline_execution_id"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "owner_phase": {
      "enum": [
        "investigation",
        "handoff"
      ]
    },
    "request_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "supported",
        "contradicted",
        "disabled",
        "containment_unavailable",
        "budget_deferred",
        "execution_failed"
      ]
    },
    "sandbox": {
      "enum": [
        "none",
        "bubblewrap"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_experiments",
        "max_concurrency",
        "timeout_seconds",
        "cpu_seconds",
        "memory_mb",
        "max_processes",
        "max_output_kb"
      ],
      "properties": {
        "max_experiments": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrency": {
          "const": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "max_processes": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_kb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason",
        "next_action",
        "evidence_refs",
        "missing_fact"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "established",
            "contradicted",
            "locally_unresolved",
            "externally_blocked",
            "budget_deferred",
            "execution_failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "missing_fact": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "interpretation_boundary": {
      "const": "Only the isolated behavior was exercised; no production exposure, credential validity, end-to-end exploitability, finding confirmation, or patch validation is established."
    },
    "execution_kind": {
      "const": "advantage"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_view": {
      "enum": [
        "base",
        "derived"
      ]
    },
    "baseline_execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_fingerprint": {}
  }
}
