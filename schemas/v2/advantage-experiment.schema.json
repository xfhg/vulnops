{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advantage linked experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "owner_phase",
    "owner_ref",
    "obligation",
    "static_limitation",
    "behavior",
    "supports",
    "contradicts",
    "input_refs",
    "dependencies",
    "execution_policy",
    "interpretation_boundary",
    "command",
    "support_exit_code",
    "contradict_exit_code",
    "execution_kind",
    "owner_id",
    "question_id",
    "source_view",
    "baseline_execution_id"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "owner_phase": {
      "enum": [
        "investigation",
        "handoff"
      ]
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "obligation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "static_limitation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "behavior": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "supports": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "contradicts": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "input_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "execution_id",
              "artifact_ref",
              "sha256"
            ],
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "artifact_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "execution_policy": {
      "const": "safe_offline_disposable"
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "support_exit_code": {
      "const": 0
    },
    "contradict_exit_code": {
      "const": 1
    },
    "execution_kind": {
      "const": "advantage"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_view": {
      "enum": [
        "base",
        "derived"
      ]
    },
    "baseline_execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_fingerprint": {}
  }
}
