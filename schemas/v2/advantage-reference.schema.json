{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "artifact_ref"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {}
  }
}
