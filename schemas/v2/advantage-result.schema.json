{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_kind",
    "task_id",
    "pass_id",
    "packet_sha256",
    "attempt",
    "provenance",
    "question_outcomes",
    "candidates",
    "additional_baseline_refs"
  ],
  "properties": {
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "non_promoted": {"type": "array", "maxItems": 2048, "items": {"$ref": "evidence-accounting.schema.json#/$defs/nonPromoted"}},
    "graph_receipt_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "graph_limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    },
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "execution_kind": {
      "const": "advantage"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "pass_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "actor",
        "selector",
        "artifact_ref"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "question_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "objective_id",
          "resolution"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "objective_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "reason",
              "established_facts",
              "counterevidence",
              "evidence_refs",
              "missing_fact",
              "next_action"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "established",
                  "contradicted",
                  "locally_unresolved",
                  "externally_blocked",
                  "budget_deferred",
                  "execution_failed",
                  "redundant"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "established_facts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "maxItems": 64,
                "minItems": 0
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "execution_id",
                        "artifact_ref"
                      ],
                      "properties": {
                        "execution_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "artifact_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  ]
                },
                "maxItems": 128,
                "minItems": 0
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "execution_id",
                        "artifact_ref"
                      ],
                      "properties": {
                        "execution_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "artifact_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  ]
                },
                "maxItems": 128,
                "minItems": 0
              },
              "missing_fact": {
                "type": "string",
                "maxLength": 8000
              },
              "next_action": {
                "type": "string",
                "maxLength": 8000
              }
            }
          }
        }
      },
      "maxItems": 64,
      "minItems": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "baseline_ids",
          "root_cause_key",
          "terminal_impact",
          "evidence_refs",
          "source_locations",
          "reason"
        ],
        "properties": {
          "optional_support": {"type": "array", "maxItems": 128, "items": {"$ref": "evidence-accounting.schema.json#/$defs/optionalSupport"}},
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "classification": {
            "enum": [
              "new_root",
              "new_chain",
              "impact_expansion",
              "baseline_correction",
              "baseline_revalidation"
            ]
          },
          "baseline_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 128,
            "minItems": 0
          },
          "root_cause_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "terminal_impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "execution_id",
                    "artifact_ref"
                  ],
                  "properties": {
                    "execution_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "artifact_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              ]
            },
            "maxItems": 128,
            "minItems": 1
          },
          "source_locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "line"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "maxItems": 64,
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        }
      },
      "maxItems": 128,
      "minItems": 0
    },
    "additional_baseline_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "execution_id",
              "artifact_ref"
            ],
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "artifact_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      },
      "maxItems": 128,
      "minItems": 0
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    }
  }
}
