{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_kind",
    "sources",
    "source_examples"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "execution_kind": {
      "const": "advantage"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_view",
          "reference",
          "line_count"
        ],
        "properties": {
          "source_view": {
            "enum": [
              "base",
              "derived"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "file_sha256": {},
          "line_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 32768,
      "minItems": 0
    },
    "source_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_view",
          "example_sha256"
        ],
        "properties": {
          "source_view": {
            "enum": [
              "base",
              "derived"
            ]
          },
          "example_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 2048,
      "minItems": 0
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
