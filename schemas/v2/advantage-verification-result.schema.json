{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_kind",
    "finding_id",
    "dossier_review",
    "objective_results",
    "status",
    "closure_reason",
    "evidence_refs",
    "primitive_results",
    "transition_results",
    "joint_conditions",
    "corrections",
    "corrected_finding",
    "actor",
    "model",
    "model_diversity",
    "assignment_sha256",
    "attempt",
    "fresh_context"
  ],
  "properties": {
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "non_promoted": {"type": "array", "maxItems": 2048, "items": {"$ref": "evidence-accounting.schema.json#/$defs/nonPromoted"}},
    "optional_support_reviews": {"type": "array", "maxItems": 128, "items": {"$ref": "evidence-accounting.schema.json#/$defs/optionalReview"}},
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "execution_kind": {
      "const": "advantage"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3}$"
    },
    "dossier_review": {
      "$ref": "advantage-synthesis.schema.json#/$defs/dossierReview"
    },
    "objective_results": {
      "type": "array",
      "items": {
        "$ref": "advantage-synthesis.schema.json#/$defs/objectiveResult"
      },
      "maxItems": 64,
      "minItems": 0
    },
    "status": {
      "enum": [
        "verified",
        "corrected",
        "rejected",
        "needs_environment",
        "evidence_limited"
      ]
    },
    "closure_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          {
            "$ref": "advantage-reference.schema.json"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 128
    },
    "primitive_results": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "primitive_id",
          "status",
          "evidence_refs",
          "reason"
        ],
        "properties": {
          "primitive_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "rejected",
              "needs_environment"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "execution_id",
                    "artifact_ref"
                  ],
                  "properties": {
                    "execution_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "artifact_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "transition_results": {
      "type": "array",
      "items": {
        "$ref": "advantage-synthesis.schema.json#/$defs/transition"
      },
      "maxItems": 64,
      "minItems": 0
    },
    "joint_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason",
        "evidence_refs",
        "missing_fact",
        "next_action"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "established",
            "contradicted",
            "locally_unresolved",
            "externally_blocked",
            "budget_deferred",
            "execution_failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "execution_id",
                  "artifact_ref"
                ],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "artifact_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            ]
          }
        },
        "missing_fact": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "corrections": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "before",
          "after",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "corrected_finding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "advantage-synthesis.schema.json#/$defs/finding"
        }
      ]
    },
    "actor": {
      "const": "vulnops-advantage-verify-one"
    },
    "model": {
      "$ref": "synthesis-findings.schema.json#/$defs/modelSelector"
    },
    "model_diversity": {
      "type": "boolean"
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "fresh_context": {
      "const": true
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    }
  }
}
