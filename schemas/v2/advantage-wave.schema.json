{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_kind",
    "wave",
    "tasks"
  ],
  "properties": {
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "execution_kind": {
      "const": "advantage"
    },
    "wave": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment",
          "continuation"
        ],
        "properties": {
          "assignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "pass_id",
              "question_ids",
              "priority",
              "allocation_reason",
              "initial_access",
              "known_information",
              "available_capabilities",
              "absent_privileges",
              "source_view"
            ],
            "properties": {
              "graph_questions": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "campaign-plan.schema.json#/$defs/campaign/properties/graph_questions/items"
                }
              },
              "task_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "pass_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "question_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "maxItems": 64,
                "minItems": 1
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "allocation_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "initial_access": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "known_information": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "maxItems": 64,
                "minItems": 0
              },
              "available_capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "capability",
                    "status",
                    "conditions",
                    "evidence_refs"
                  ],
                  "properties": {
                    "capability": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "status": {
                      "enum": [
                        "source_established",
                        "conditional",
                        "observed_contained"
                      ]
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      "maxItems": 32,
                      "minItems": 0
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "execution_id",
                              "artifact_ref"
                            ],
                            "properties": {
                              "execution_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512
                              },
                              "artifact_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            }
                          }
                        ]
                      },
                      "maxItems": 128,
                      "minItems": 1
                    }
                  }
                },
                "maxItems": 64,
                "minItems": 0
              },
              "absent_privileges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "maxItems": 64,
                "minItems": 0
              },
              "source_view": {
                "enum": [
                  "base",
                  "derived"
                ]
              }
            }
          },
          "continuation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predecessor_task_id",
              "predecessor_sha256",
              "changed_hypothesis",
              "evidence_delta",
              "alternative_path",
              "next_proof_obligation"
            ],
            "properties": {
              "predecessor_task_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "predecessor_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "changed_hypothesis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "evidence_delta": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "execution_id",
                        "artifact_ref"
                      ],
                      "properties": {
                        "execution_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "artifact_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  ]
                },
                "maxItems": 128,
                "minItems": 0
              },
              "alternative_path": {
                "type": "string",
                "maxLength": 8000
              },
              "next_proof_obligation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        }
      },
      "maxItems": 512,
      "minItems": 1
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    }
  }
}
