{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Red-Team Campaign Plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "depth", "budget", "attack_objectives", "investigation_questions", "question_dispositions", "selection_revisions", "scanner_accounting", "evidence_dispositions", "campaigns", "coverage", "warnings", "discovery_ref"],
  "properties": {
    "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
    "attack_objectives": {"type": "array", "items": {"$ref": "objective.schema.json#/$defs/objective"}},
    "investigation_questions": {"type": "array", "items": {"$ref": "objective.schema.json#/$defs/question"}},
    "question_dispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["objective_id", "question_id", "campaign_ids", "evidence_ids", "status", "equivalent_to", "reason", "missing_fact", "next_action"],
      "properties": {
        "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
        "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
        "campaign_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CAM-[0-9]{3}$"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}},
        "status": {"enum": ["selected", "equivalent", "deferred", "evidence_limited"]},
        "equivalent_to": {"type": ["string", "null"], "pattern": "^Q-[A-F0-9]{12}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1200},
        "missing_fact": {"type": "string", "minLength": 1, "maxLength": 4000},
        "next_action": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    }},
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1}, "depth": {"enum": ["quick", "balanced", "full"]},
    "discovery_ref": {"const": "campaign-planning/discovery.json"},
    "discovery_sha256": {},
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "evidence_dispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["evidence_id", "campaign_ids", "status", "missing_fact", "attempted_resolution", "next_action", "deferral_reason", "priority_reason"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"},
        "campaign_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CAM-[0-9]{3}$"}},
        "status": {"enum": ["selected", "evidence_limited"]},
        "missing_fact": {"type": "string", "minLength": 1}, "attempted_resolution": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1}, "deferral_reason": {"type": "string"},
        "priority_reason": {"type": "string", "minLength": 1}
      }
    }},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_campaigns"], "properties": {"max_campaigns": {"enum": [4, 10, 20]}}},
    "selection_revisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["author", "reason", "evidence_ids", "question_ids"], "properties": {
      "author": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
      "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"}},
      "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}}
    }}},
    "scanner_accounting": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "status", "reason", "campaign_ids"], "properties": {
      "evidence_id": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}, "status": {"enum": ["selected", "deferred", "contradicted"]},
      "reason": {"type": "string", "minLength": 1}, "campaign_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CAM-[0-9]{3}$"}}
    }}},
    "campaigns": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/campaign"}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["evidence_records", "primitives", "campaigns"], "properties": {"evidence_records": {"type": "integer", "minimum": 0}, "primitives": {"type": "integer", "minimum": 0}, "campaigns": {"type": "integer", "minimum": 0}}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"campaign": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "objective_id", "question_id", "lane", "starting_evidence", "primitive_ids", "attacker_capability", "target_boundary", "hypothesis", "source_files", "graph_questions", "graph_limitations", "validation_method", "stop_conditions", "expected_added_value", "disposition", "relationship_ids", "selection_reason", "priority_band"],
    "properties": {
      "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
      "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
      "id": {"type": "string", "pattern": "^CAM-[0-9]{3}$"}, "lane": {"enum": ["primitive_led", "gap_driven", "direct_validation"]},
      "starting_evidence": {"type": "array", "items": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}, "minItems": 1, "uniqueItems": true},
      "primitive_ids": {"type": "array", "items": {"type": "string", "pattern": "^P-[A-F0-9]{12}$"}, "uniqueItems": true},
      "relationship_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^REL-[A-F0-9]{12}$"}},
      "selection_reason": {"type": "string", "minLength": 1, "maxLength": 1200},
      "priority_band": {"enum": ["proof_obligation", "continuation", "source_hypothesis", "scanner_triage", "exploratory"]},
      "attacker_capability": {"type": "string", "minLength": 1}, "target_boundary": {"type": "string", "minLength": 1}, "hypothesis": {"type": "string", "minLength": 1},
      "source_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "graph_questions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "subject", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"enum": ["query", "callers", "callees", "impact", "affected"]}, "subject": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
      "graph_limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
      "validation_method": {"type": "string", "minLength": 1}, "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
      "expected_added_value": {"type": "string", "minLength": 1}, "disposition": {"const": "unresolved"}
    }
  }}
}
