{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Red-Team Campaign Plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "depth", "budget", "campaigns", "coverage", "warnings"],
  "properties": {
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1}, "depth": {"enum": ["quick", "balanced", "full"]},
    "budget": {"type": "object", "additionalProperties": false, "required": ["primitive_led", "gap_driven", "direct_validation"], "properties": {"primitive_led": {"type": "integer", "minimum": 0}, "gap_driven": {"type": "integer", "minimum": 0}, "direct_validation": {"type": "integer", "minimum": 0}}},
    "campaigns": {"type": "array", "items": {"$ref": "#/$defs/campaign"}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["evidence_records", "primitives", "campaigns"], "properties": {"evidence_records": {"type": "integer", "minimum": 0}, "primitives": {"type": "integer", "minimum": 0}, "campaigns": {"type": "integer", "minimum": 0}}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"campaign": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "lane", "starting_evidence", "primitive_ids", "attacker_capability", "target_boundary", "hypothesis", "source_files", "graph_questions", "validation_method", "stop_conditions", "expected_added_value", "disposition"],
    "properties": {
      "id": {"type": "string", "pattern": "^CAM-[0-9]{3}$"}, "lane": {"enum": ["primitive_led", "gap_driven", "direct_validation"]},
      "starting_evidence": {"type": "array", "items": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}, "minItems": 1, "uniqueItems": true},
      "primitive_ids": {"type": "array", "items": {"type": "string", "pattern": "^P-[A-F0-9]{12}$"}, "uniqueItems": true},
      "attacker_capability": {"type": "string", "minLength": 1}, "target_boundary": {"type": "string", "minLength": 1}, "hypothesis": {"type": "string", "minLength": 1},
      "source_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "graph_questions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "subject", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"enum": ["query", "callers", "callees", "impact", "affected"]}, "subject": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
      "validation_method": {"type": "string", "minLength": 1}, "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
      "expected_added_value": {"type": "string", "minLength": 1}, "disposition": {"const": "unresolved"}
    }
  }}
}
