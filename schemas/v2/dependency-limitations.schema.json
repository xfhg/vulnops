{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Offline Dependency Coverage Limitations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "limitations"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "files"],
        "properties": {
          "code": {"enum": ["conan_offline_sca_unsupported", "bundled_scanner_input_unsupported", "npm_lockfile_no_dependency_inventory", "requirements_no_dependency_inventory", "requirements_reviewed_non_dependency"]},
          "message": {"type": "string", "minLength": 1, "maxLength": 1000},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "reviews": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "sha256", "reason"],
              "properties": {
                "file": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reason": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        },
        "allOf": [{"oneOf": [
          {"properties": {"code": {"enum": ["conan_offline_sca_unsupported", "bundled_scanner_input_unsupported", "npm_lockfile_no_dependency_inventory", "requirements_no_dependency_inventory"]}, "reviews": {"maxItems": 0}}},
          {"properties": {"code": {"const": "requirements_reviewed_non_dependency"}}, "required": ["reviews"]}
        ]}]
      }
    }
  }
}
