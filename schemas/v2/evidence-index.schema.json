{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Canonical Evidence and Primitive Index",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "attack_objectives", "investigation_questions", "records", "primitives", "coverage_gaps", "warnings"],
  "properties": {
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1},
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "attack_objectives": {"type": "array", "items": {"$ref": "objective.schema.json#/$defs/objective"}},
    "investigation_questions": {"type": "array", "items": {"$ref": "objective.schema.json#/$defs/question"}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "primitives": {"type": "array", "items": {"$ref": "#/$defs/primitive"}},
    "coverage_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "contributors": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["actor", "selector", "artifact_ref"], "properties": {"actor": {"type": "string", "minLength": 1}, "selector": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}}}},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "operation", "resource_scope", "authority", "conditions", "evidence_status", "provenance", "restrictions"],
      "properties": {
        "actor": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1},
        "resource_scope": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_status": {"enum": ["hypothesized", "source_established", "experimentally_observed", "contradicted"]},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_kind", "source_id", "artifact_ref", "disposition", "summary", "files", "source_anchors", "subsystems", "anchor_limitations", "contributors"],
      "dependentRequired": {"objective_id": ["question_id"], "question_id": ["objective_id"]},
      "properties": {
        "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
        "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
        "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
        "resolution": {"$ref": "hunt-result.schema.json#/$defs/resolution"},
        "checkpoint": {"$ref": "hunt-result.schema.json#/$defs/checkpoint"},
        "contributors": {"$ref": "#/$defs/contributors"},
        "non_promoted": {"$ref": "evidence-accounting.schema.json#/$defs/nonPromoted"},
        "evidence_quality": {"enum": ["resolved", "evidence_limited"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "navigation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk_context": {"type": "object", "additionalProperties": false, "required": ["actor", "reachability", "impact", "priority"], "properties": {
          "actor": {"type": "string"}, "reachability": {"type": "string"}, "impact": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1, "maximum": 5}
        }},
        "id": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"},
        "source_kind": {"enum": ["recon", "threat_model", "sca", "secret", "sast", "coverage", "hardening", "positive_pattern", "reproduction", "tool_warning"]},
        "source_id": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["promoted", "closed", "rejected", "needs_environment", "unresolved", "evidence_limited"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "subsystems": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "anchor_limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "source_anchors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["file"], "properties": {"file": {"type": "string", "minLength": 1}, "entrypoint_id": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}}}}
      }
    },
    "primitive": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "trust", "source_record_ids", "prerequisites", "capability_gained", "boundary", "reachable_assets", "conditions", "evidence_refs", "contributors"],
      "properties": {
        "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
        "contributors": {"$ref": "#/$defs/contributors"},
        "capability": {"$ref": "#/$defs/capability"},
        "id": {"type": "string", "pattern": "^P-[A-F0-9]{12}$"},
        "type": {"enum": ["vulnerability", "credential", "access", "control_gap", "state_transition", "environment_constraint"]},
        "trust": {"enum": ["confirmed", "candidate", "context_only"]},
        "source_record_ids": {"type": "array", "items": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}, "minItems": 1, "uniqueItems": true},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "capability_gained": {"type": "string", "minLength": 1}, "boundary": {"type": "string", "minLength": 1},
        "reachable_assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    }
  }
}
