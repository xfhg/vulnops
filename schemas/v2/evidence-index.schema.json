{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Canonical Evidence and Primitive Index",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "records", "primitives", "coverage_gaps", "warnings"],
  "properties": {
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "primitives": {"type": "array", "items": {"$ref": "#/$defs/primitive"}},
    "coverage_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_kind", "source_id", "artifact_ref", "disposition", "summary", "files"],
      "properties": {
        "id": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"},
        "source_kind": {"enum": ["recon", "sca", "secret", "sast", "coverage", "hardening", "positive_pattern", "reproduction", "tool_warning"]},
        "source_id": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["promoted", "closed", "rejected", "needs_environment", "unresolved"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "primitive": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "trust", "source_record_ids", "prerequisites", "capability_gained", "boundary", "reachable_assets", "conditions", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^P-[A-F0-9]{12}$"},
        "type": {"enum": ["vulnerability", "credential", "access", "control_gap", "state_transition", "environment_constraint"]},
        "trust": {"enum": ["confirmed", "candidate", "context_only"]},
        "source_record_ids": {"type": "array", "items": {"type": "string", "pattern": "^E-[A-F0-9]{12}$"}, "minItems": 1, "uniqueItems": true},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "capability_gained": {"type": "string", "minLength": 1}, "boundary": {"type": "string", "minLength": 1},
        "reachable_assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    }
  }
}
