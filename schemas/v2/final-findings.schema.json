{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Independently Verified Findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_diversity", "findings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "model_diversity": {"const": false},
    "findings": {
      "type": "array",
      "items": {"oneOf": [{"$ref": "#/$defs/fullFinding"}, {"$ref": "#/$defs/rejectedFinding"}]}
    }
  },
  "$defs": {
    "traceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "line", "scope", "description"],
      "properties": {
        "kind": {"enum": ["entrypoint", "propagation", "sink"]},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "scope": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"enum": ["authentication_level", "authorization_role", "user_interaction", "system_configuration", "network_routing", "environmental_dependency", "data_state", "timing_dependency", "third_party_dependency"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "severityAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason"],
      "properties": {
        "score": {"enum": ["informational", "low", "medium", "high", "critical"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "raw_refs", "intelligence_refs", "graph_refs", "validation_refs", "independent_verification_ref"],
      "properties": {
        "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "raw_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "intelligence_refs": {"type": "array", "items": {"type": "string"}},
        "graph_refs": {"type": "array", "items": {"type": "string"}},
        "validation_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "independent_verification_ref": {"type": "string", "minLength": 1}
      }
    },
    "fullFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "verdict", "finding_kind", "title", "category",
        "attack_class_ids", "methodology_refs", "lenses", "description",
        "root_cause", "root_cause_location", "intended_behavior", "attacker",
        "trace", "conditions", "verification", "remediation", "severity",
        "confidence", "provenance", "closure_reason", "dependency", "secret"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "verdict": {"enum": ["confirmed", "needs_environment"]},
        "finding_kind": {"enum": ["code", "dependency", "secret"]},
        "title": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "attack_class_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "minItems": 1},
        "methodology_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "lenses": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1},
        "root_cause": {"type": "string", "minLength": 1},
        "root_cause_location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line", "scope", "mechanism"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "line": {"type": "integer", "minimum": 1},
            "scope": {"type": "string", "minLength": 1},
            "mechanism": {"type": "string", "minLength": 1}
          }
        },
        "intended_behavior": {"type": "string", "minLength": 1},
        "attacker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perspective", "starting_access", "boundary_crossed"],
          "properties": {
            "perspective": {"type": "string", "minLength": 1},
            "starting_access": {"type": "string", "minLength": 1},
            "boundary_crossed": {"type": "string", "minLength": 1}
          }
        },
        "trace": {"type": "array", "items": {"$ref": "#/$defs/traceStep"}},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "source_validation_ref", "reproduction_ref", "reproduction_status", "model", "model_diversity"],
          "properties": {
            "level": {"enum": ["source_verified", "dynamic_verified", "environment_required"]},
            "source_validation_ref": {"type": "string", "minLength": 1},
            "reproduction_ref": {"type": ["string", "null"]},
            "reproduction_status": {"enum": ["not_requested", "dynamic_verified", "environment_required", "failed"]},
            "model": {"type": "string", "minLength": 1},
            "model_diversity": {"const": false}
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "test_ref", "patch_ref", "patch_status"],
          "properties": {
            "strategy": {"type": "string", "minLength": 1},
            "test_ref": {"type": ["string", "null"]},
            "patch_ref": {"type": ["string", "null"]},
            "patch_status": {"enum": ["not_generated", "proposed", "fail_pass_verified"]}
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["likelihood", "impact", "overall"],
          "properties": {
            "likelihood": {"$ref": "#/$defs/severityAxis"},
            "impact": {"$ref": "#/$defs/severityAxis"},
            "overall": {"enum": ["informational", "low", "medium", "high", "critical"]}
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "reason"],
          "properties": {
            "score": {"enum": ["low", "medium", "high"]},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "closure_reason": {"type": "string", "minLength": 1},
        "dependency": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["advisory_id", "package", "installed_version", "affected_use", "reachability"],
              "properties": {
                "advisory_id": {"type": "string", "minLength": 1},
                "package": {"type": "string", "minLength": 1},
                "installed_version": {"type": "string", "minLength": 1},
                "affected_use": {"type": "string", "minLength": 1},
                "reachability": {"enum": ["reachable", "not_reachable", "unknown"]}
              }
            }
          ]
        },
        "secret": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "file", "line", "redaction", "exposure_path", "validity"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "file": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "redaction": {"const": "<redacted>"},
                "exposure_path": {"type": "string", "minLength": 1},
                "validity": {"enum": ["confirmed_format", "likely", "unknown", "revoked"]}
              }
            }
          ]
        }
      }
    },
    "rejectedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verdict", "finding_kind", "title", "closure_reason", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "verdict": {"const": "rejected"},
        "finding_kind": {"enum": ["code", "dependency", "secret"]},
        "title": {"type": "string", "minLength": 1},
        "closure_reason": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
