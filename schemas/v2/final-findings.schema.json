{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Final Verified Findings",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_diversity", "findings", "rejections"],
  "properties": {
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1}, "model_diversity": {"type": "boolean"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "rejections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "reason", "independent_verification_ref"], "properties": {"id": {"type": "string", "pattern": "^F-[0-9]{3}$"}, "reason": {"type": "string", "minLength": 1}, "independent_verification_ref": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "location": {"type": "object", "additionalProperties": false, "required": ["file", "line", "scope", "mechanism"], "properties": {"file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "scope": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1}}},
    "trace": {"type": "object", "additionalProperties": false, "required": ["kind", "file", "line", "scope", "description"], "properties": {"kind": {"enum": ["entrypoint", "propagation", "sink"]}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "scope": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "sourceRef": {"type": "object", "additionalProperties": false, "required": ["kind", "source_id", "artifact_ref"], "properties": {"kind": {"enum": ["recon", "sca", "secret", "sast", "campaign", "intrusion", "reproduction"]}, "source_id": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}}},
    "primitiveStep": {"type": "object", "additionalProperties": false, "required": ["primitive_id", "input_capability", "output_capability", "boundary_crossed", "evidence_refs"], "properties": {"primitive_id": {"type": "string", "minLength": 1}, "input_capability": {"type": "string", "minLength": 1}, "output_capability": {"type": "string", "minLength": 1}, "boundary_crossed": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}}},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "finding_kind", "origin", "title", "category", "severity", "risk_score", "confidence", "status", "verdict", "attacker", "intended_behavior", "root_causes", "trace", "conditions", "impact", "remediation", "verification", "primitive_steps", "source_refs", "graph_receipt_refs", "closure_rationale", "dependency", "secret", "model_diversity", "independent_verification_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{3}$"}, "finding_kind": {"enum": ["code", "dependency", "secret", "chain"]}, "origin": {"enum": ["standalone_known", "known_impact_expansion", "composite_chain", "independent_discovery", "cross_evidence_discovery"]},
        "title": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "severity": {"enum": ["informational", "low", "medium", "high", "critical"]}, "risk_score": {"type": "integer", "minimum": 0, "maximum": 100}, "confidence": {"enum": ["low", "medium", "high"]},
        "status": {"enum": ["verified", "needs_environment"]}, "verdict": {"enum": ["confirmed", "needs_environment"]},
        "attacker": {"type": "object", "additionalProperties": false, "required": ["perspective", "starting_access", "boundary_crossed"], "properties": {"perspective": {"type": "string", "minLength": 1}, "starting_access": {"type": "string", "minLength": 1}, "boundary_crossed": {"type": "string", "minLength": 1}}},
        "intended_behavior": {"type": "string", "minLength": 1}, "root_causes": {"type": "array", "items": {"$ref": "#/$defs/location"}, "minItems": 1}, "trace": {"type": "array", "items": {"$ref": "#/$defs/trace"}, "minItems": 2}, "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "impact": {"type": "string", "minLength": 1}, "remediation": {"type": "string", "minLength": 1},
        "verification": {"type": "object", "additionalProperties": false, "required": ["level", "model", "source_validation_refs", "reproduction_ref"], "properties": {"level": {"enum": ["source_verified", "dynamic_verified", "environment_required"]}, "model": {"type": "string", "minLength": 1}, "source_validation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "reproduction_ref": {"type": ["string", "null"]}}},
        "primitive_steps": {"type": "array", "items": {"$ref": "#/$defs/primitiveStep"}}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}, "minItems": 1}, "graph_receipt_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "closure_rationale": {"type": "string", "minLength": 1},
        "dependency": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["advisory_id", "package", "installed_version", "affected_use", "reachability"], "properties": {"advisory_id": {"type": "string", "minLength": 1}, "package": {"type": "string", "minLength": 1}, "installed_version": {"type": "string", "minLength": 1}, "affected_use": {"type": "string", "minLength": 1}, "reachability": {"enum": ["reachable", "not_reachable", "unknown"]}}}]},
        "secret": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["type", "file", "line", "redaction", "exposure_path", "validity"], "properties": {"type": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "redaction": {"const": "<redacted>"}, "exposure_path": {"type": "string", "minLength": 1}, "validity": {"enum": ["confirmed_format", "likely", "unknown", "revoked"]}}}]},
        "model_diversity": {"type": "boolean"}, "independent_verification_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
