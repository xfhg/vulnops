{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Final Verified Findings",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","run_id","verifier_model","model_diversity","diversity_counts","findings","rejections","objective_assessments"],
  "properties": {
    "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1}, "model_diversity": {"type": "boolean"},
    "objective_assessments": {"$ref":"synthesis-findings.schema.json#/properties/objective_assessments"},
    "verifier_model": {"$ref": "synthesis-findings.schema.json#/$defs/modelSelector"},
    "diversity_counts": {"$ref": "#/$defs/diversityCounts"},
    "prior_run_reconciliation": {"type": "array", "items": {"$ref": "synthesis-findings.schema.json#/$defs/reconciliation"}},
    "input_claims": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/inputClaim"}},
    "non_promoted": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/nonPromoted"}},
    "unreviewed": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/unreviewed"}},
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "rejections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "reason", "independent_verification_ref"], "properties": {"assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"}, "id": {"type": "string", "pattern": "^F-[0-9]{3}$"}, "reason": {"type": "string", "minLength": 1}, "independent_verification_ref": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "diversityCounts": {"type": "object", "additionalProperties": false, "required": ["diverse", "same_model", "total"], "properties": {"diverse": {"type": "integer", "minimum": 0}, "same_model": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["id", "finding_kind", "origin", "title", "category", "severity", "risk_score", "confidence", "status", "attacker", "intended_behavior", "root_causes", "trace", "conditions", "impact", "remediation", "verification", "contributors", "primitive_steps", "transitions", "source_refs", "graph_receipt_refs", "closure_rationale", "dependency", "secret", "objective_ids", "attack_summary", "affected_components", "exploitation", "technical_examples", "impact_limits", "verdict", "model_diversity", "independent_verification_ref"], "properties": {"assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"}, "id": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/id"}, "finding_kind": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/finding_kind"}, "origin": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/origin"}, "title": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/title"}, "category": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/category"}, "severity": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/severity"}, "risk_score": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/risk_score"}, "confidence": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/confidence"}, "status": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/status"}, "attacker": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/attacker"}, "intended_behavior": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/intended_behavior"}, "root_causes": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/root_causes"}, "trace": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/trace"}, "conditions": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/conditions"}, "impact": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/impact"}, "remediation": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/remediation"}, "verification": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/verification"}, "contributors": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/contributors"}, "primitive_steps": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/primitive_steps"}, "transitions": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/transitions"}, "source_refs": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/source_refs"}, "graph_receipt_refs": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/graph_receipt_refs"}, "closure_rationale": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/closure_rationale"}, "dependency": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/dependency"}, "secret": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/secret"}, "objective_ids": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/objective_ids"}, "attack_summary": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/attack_summary"}, "affected_components": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/affected_components"}, "exploitation": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/exploitation"}, "technical_examples": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/technical_examples"}, "impact_limits": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/impact_limits"}, "optional_support": {"$ref": "synthesis-findings.schema.json#/$defs/finding/properties/optional_support"}, "verdict": {"enum": ["confirmed", "needs_environment"]}, "model_diversity": {"type": "boolean"}, "independent_verification_ref": {"type": "string", "minLength": 1, "maxLength": 512}}}
  }
}
