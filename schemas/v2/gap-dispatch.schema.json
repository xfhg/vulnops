{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "execution_kind": {
      "const": "advantage"
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    },
    "phase": {
      "const": "gap-exploration"
    },
    "started_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "workers": {
      "type": "array",
      "items": {
        "$ref": "gap-common.schema.json#/$defs/worker"
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finalization": {
      "type": "object", "additionalProperties": false,
      "required": ["results_sha256", "failure_reason"],
      "properties": {
        "results_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "failure_reason": {"type": ["string", "null"]}
      }
    },
    "graph_consumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preparations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0,
          "maxItems": 1024
        }
      },
      "required": [
        "preparations",
        "queries"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "phase",
    "started_at",
    "workers",
    "graph_consumption"
  ]
}
