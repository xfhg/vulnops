{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application-wide gap exploration allowance",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "max_questions", "graph_timeout_seconds", "preparation_timeout_seconds", "max_tasks", "max_concurrency", "max_attempts", "max_candidates", "timeout_seconds", "synthesis_timeout_seconds", "verification_timeout_seconds"],
  "properties": {
    "enabled": {"type": "boolean"},
    "max_questions": {"$ref": "#/$defs/bound"},
    "graph_timeout_seconds": {"$ref": "#/$defs/bound"},
    "preparation_timeout_seconds": {"$ref": "#/$defs/bound"},
    "max_tasks": {"$ref": "#/$defs/bound"},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "max_candidates": {"$ref": "#/$defs/bound"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483},
    "synthesis_timeout_seconds": {"$ref": "#/$defs/bound"},
    "verification_timeout_seconds": {"$ref": "#/$defs/bound"}
  },
  "$defs": {"bound": {"type": "integer", "minimum": 0, "maximum": 2147483}}
}
