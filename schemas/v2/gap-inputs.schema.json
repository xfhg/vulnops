{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "execution_kind": {
      "const": "advantage"
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "gap-common.schema.json#/$defs/record"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "budget": {
      "$ref": "gap-common.schema.json#/$defs/budget"
    },
    "baseline": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "inputs",
    "budget"
  ]
}
