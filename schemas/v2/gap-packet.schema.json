{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "execution_kind": {
      "const": "advantage"
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    },
    "assignment": {
      "$ref": "gap-common.schema.json#/$defs/assignment"
    },
    "seed": {
      "$ref": "gap-common.schema.json#/$defs/seed"
    },
    "objective": {
      "oneOf": [
        {"$ref": "objective.schema.json#/$defs/objective"},
        {"$ref": "advantage-plan.schema.json#/properties/objectives/items"}
      ]
    },
    "question": {
      "oneOf": [
        {"$ref": "objective.schema.json#/$defs/question"},
        {"$ref": "advantage-plan.schema.json#/properties/questions/items"}
      ]
    },
    "graph_questions": {
      "type": "array",
      "items": {
        "$ref": "gap-common.schema.json#/$defs/graphQuestion"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "gap-common.schema.json#/$defs/record"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_candidates": {
      "const": 2
    },
    "baseline": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "assignment",
    "seed",
    "objective",
    "question",
    "graph_questions",
    "inputs",
    "plan_sha256",
    "max_candidates"
  ]
}
