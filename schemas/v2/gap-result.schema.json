{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_sha256", "source_receipts", "support"],
      "properties": {
        "runtime_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_receipts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "source_view", "sha256"],
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "source_view": {"enum": ["base", "derived"]},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "support": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "sha256"],
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "execution_kind": {
      "const": "advantage"
    },
    "assessment_context": {
      "$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "objective_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "source_view": {
      "enum": [
        "base",
        "derived"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "actor",
        "selector",
        "artifact_ref"
      ]
    },
    "resolution": {
      "$ref": "gap-common.schema.json#/$defs/resolution"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "gap-common.schema.json#/$defs/candidate"
      },
      "minItems": 0,
      "maxItems": 2
    },
    "graph_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "minItems": 0,
      "maxItems": 128
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "task_id",
    "objective_id",
    "question_id",
    "source_view",
    "attempt",
    "provenance",
    "resolution",
    "candidates",
    "graph_receipt_refs",
    "limitations"
  ]
}
