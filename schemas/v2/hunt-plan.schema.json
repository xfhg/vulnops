{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Hunt Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attack_objectives", "investigation_questions", "rationale", "budget", "custom_attack_classes", "cells", "tasks", "warnings", "errors"],
  "properties": {
    "depth": {"enum": ["quick", "balanced", "full"]},
    "deferred_task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attack_objectives": {"type": "array", "items": {"$ref": "objective.schema.json#/$defs/objective"}},
    "investigation_questions": {"type": "array", "items": {"$ref": "objective.schema.json#/$defs/question"}},
    "model_amendments": {"$ref": "hunt-result.schema.json#/properties/model_amendments"},
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "max_hunt_tasks", "max_hunt_questions", "max_gapfill_rounds", "max_attempts", "context_packet_bytes"],
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_hunt_tasks": {"type": "integer", "minimum": 1},
        "max_hunt_questions": {"type": "integer", "minimum": 1},
        "max_gapfill_rounds": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "context_packet_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "custom_attack_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "methodology", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "title": {"type": "string", "minLength": 1},
          "methodology": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "mapping_id", "objective_id", "question_id", "surface_ids", "subsystem", "attack_class_id",
          "domain", "methodology_refs", "lenses", "status", "priority",
          "threat_ids", "asset_ids", "attacker", "entrypoint_ids",
          "boundary_ids", "files", "security_question", "stop_conditions",
          "applicability_reason", "evidence_refs", "owner", "lead_key",
          "disposition_reason"
        ],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
          "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "mapping_id": {"type": "string", "minLength": 1},
          "surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_id": {"type": "string", "minLength": 1},
          "domain": {"enum": ["general", "ai_llm", "http_auth", "client", "native", "mobile", "iac", "etl"]},
          "methodology_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "lenses": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "status": {"enum": ["planned", "tool_satisfied", "finding", "clean", "not_applicable", "deferred", "shallow", "failed"]},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "threat_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "attacker": {"type": "string", "minLength": 1},
          "entrypoint_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "boundary_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "security_question": {"type": "string", "minLength": 12},
          "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "applicability_reason": {"type": "string", "minLength": 12},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "owner": {"enum": ["sast", "sca", "secrets"]},
          "lead_key": {"type": ["string", "null"]},
          "disposition_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective_ids", "question_ids", "cell_ids", "subsystem", "attack_class_ids", "domain", "methodology_refs", "lenses", "files", "entrypoints", "evidence_refs", "attempt", "round"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "objective_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"}},
          "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"}},
          "continuations": {"type": "array", "items": {"type": "object", "additionalProperties": false,
            "required": ["cell_id", "objective_id", "question_id", "resolution", "checkpoint", "source_expansions", "evidence_refs"],
            "properties": {
              "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
              "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
              "cell_id": {"type": "string", "minLength": 1},
              "resolution": {"$ref": "hunt-result.schema.json#/$defs/resolution"},
              "checkpoint": {"$ref": "hunt-result.schema.json#/$defs/checkpoint"},
              "source_expansions": {"$ref": "hunt-result.schema.json#/properties/cell_results/items/properties/source_expansions"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }}},
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "cell_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "minItems": 1, "maxItems": 4, "uniqueItems": true},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 4, "uniqueItems": true},
          "domain": {"enum": ["general", "ai_llm", "http_auth", "client", "native", "mobile", "iac", "etl"]},
          "methodology_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "lenses": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "entrypoints": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "round": {"type": "integer", "minimum": 0}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
