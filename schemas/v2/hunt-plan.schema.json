{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Hunt Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "rationale", "budget", "custom_attack_classes", "cells", "tasks", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "max_hunt_tasks", "max_hunt_questions", "max_gapfill_rounds", "max_attempts", "context_packet_bytes"],
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_hunt_tasks": {"type": "integer", "minimum": 1},
        "max_hunt_questions": {"type": "integer", "minimum": 1},
        "max_gapfill_rounds": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "context_packet_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "custom_attack_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "methodology", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "title": {"type": "string", "minLength": 1},
          "methodology": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "mapping_id", "surface_ids", "subsystem", "attack_class_id",
          "domain", "methodology_refs", "lenses", "status", "priority",
          "threat_ids", "asset_ids", "attacker", "entrypoint_ids",
          "boundary_ids", "files", "security_question", "stop_conditions",
          "applicability_reason", "evidence_refs", "owner", "lead_key",
          "disposition_reason"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "mapping_id": {"type": "string", "minLength": 1},
          "surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_id": {"type": "string", "minLength": 1},
          "domain": {"enum": ["general", "ai_llm", "http_auth", "client", "native", "mobile", "iac", "etl"]},
          "methodology_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "lenses": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "status": {"enum": ["planned", "tool_satisfied", "finding", "clean", "not_applicable", "deferred", "shallow", "failed"]},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "threat_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "attacker": {"type": "string", "minLength": 1},
          "entrypoint_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "boundary_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "security_question": {"type": "string", "minLength": 12},
          "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "applicability_reason": {"type": "string", "minLength": 12},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "owner": {"enum": ["sast", "sca", "secrets"]},
          "lead_key": {"type": ["string", "null"]},
          "disposition_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cell_ids", "subsystem", "attack_class_ids", "domain", "methodology_refs", "lenses", "files", "entrypoints", "evidence_refs", "attempt", "round"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "cell_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "minItems": 1, "maxItems": 4, "uniqueItems": true},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 4, "uniqueItems": true},
          "domain": {"enum": ["general", "ai_llm", "http_auth", "client", "native", "mobile", "iac", "etl"]},
          "methodology_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "lenses": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "entrypoints": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "round": {"type": "integer", "minimum": 0}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
