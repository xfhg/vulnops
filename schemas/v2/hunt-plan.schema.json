{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Hunt Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "rationale", "budget", "custom_attack_classes", "cells", "tasks", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "max_hunt_tasks", "max_gapfill_rounds", "max_attempts", "context_packet_bytes"],
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_hunt_tasks": {"type": "integer", "minimum": 1},
        "max_gapfill_rounds": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "context_packet_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "custom_attack_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "methodology", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "title": {"type": "string", "minLength": 1},
          "methodology": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface_id", "subsystem", "attack_class_id", "domain", "status", "priority", "evidence_refs", "owner", "lead_key", "disposition_reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "surface_id": {"type": "string", "minLength": 1},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_id": {"type": "string", "minLength": 1},
          "domain": {"enum": ["general", "ai_llm", "http_auth", "client", "native", "mobile", "iac", "etl"]},
          "status": {"enum": ["planned", "tool_satisfied", "finding", "clean", "not_applicable", "deferred", "shallow", "failed"]},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "owner": {"enum": ["sast", "sca", "secrets"]},
          "lead_key": {"type": ["string", "null"]},
          "disposition_reason": {"type": "string"}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cell_ids", "subsystem", "attack_class_id", "domain", "methodology_refs", "lenses", "files", "entrypoints", "context_packet", "evidence_refs", "attempt", "round"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "cell_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "minItems": 1},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_id": {"type": "string", "minLength": 1},
          "domain": {"enum": ["general", "ai_llm", "http_auth", "client", "native", "mobile", "iac", "etl"]},
          "methodology_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "lenses": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "entrypoints": {"type": "array", "items": {"type": "string"}},
          "context_packet": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "round": {"type": "integer", "minimum": 0}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
