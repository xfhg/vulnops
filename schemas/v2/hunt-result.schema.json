{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Hunt Task Result",
  "type": "object",
  "additionalProperties": {"$ref": "exploration-context.schema.json#/$defs/value"},
  "maxProperties": 64,
  "propertyNames": {"type": "string", "maxLength": 128},
  "required": [
    "provenance",
    "schema_version", "task_id", "status", "cell_results", "files_reviewed",
    "entrypoints_traced", "sinks_reviewed", "mitigations_checked",
    "candidates", "hardening_notes", "positive_patterns", "rabbit_holes",
    "wishlist_items", "warnings", "errors", "model_amendments"
  ],
  "properties": {
    "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["actor", "selector", "artifact_ref"], "properties": {"actor": {"const": "vulnops-deepdive-chunk"}, "selector": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}}},
    "model_amendments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "allOf": [{"oneOf": [
          {"properties": {"kind": {"const": "objective"}, "entity": {"$ref": "objective.schema.json#/$defs/objective"}}},
          {"properties": {"kind": {"const": "question"}, "entity": {"$ref": "objective.schema.json#/$defs/question"}}},
          {"properties": {"kind": {"enum": ["entrypoint", "boundary", "subsystem", "surface", "asset", "threat"]}}}
        ]}],
        "required": ["id", "kind", "objective_id", "question_id", "question", "source_refs", "entity"],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
          "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["entrypoint", "boundary", "subsystem", "surface", "asset", "threat", "objective", "question"]},
          "question": {"type": "string", "minLength": 12},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "entity": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "status": {"enum": ["ok", "shallow", "failed"]},
    "cell_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": {"$ref": "exploration-context.schema.json#/$defs/value"},
        "maxProperties": 64,
        "propertyNames": {"type": "string", "maxLength": 128},
        "required": [
          "cell_id", "objective_id", "question_id", "status", "reason", "files_reviewed",
          "entrypoints_traced", "sinks_reviewed", "mitigations_checked",
          "candidate_ids", "evidence_refs", "resolution", "checkpoint", "source_expansions"
        ],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
          "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
          "resolution": {"$ref": "#/$defs/resolution"},
          "checkpoint": {"$ref": "#/$defs/checkpoint"},
          "source_expansions": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "predecessor", "reason"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "predecessor": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "cell_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "status": {"enum": ["finding", "clean", "not_applicable", "shallow", "failed"]},
          "reason": {"type": "string", "minLength": 1},
          "files_reviewed": {"type": "array", "items": {"type": "string"}},
          "entrypoints_traced": {"type": "array", "items": {"type": "string"}},
          "sinks_reviewed": {"type": "array", "items": {"type": "string"}},
          "mitigations_checked": {"type": "array", "items": {"type": "string"}},
          "candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "files_reviewed": {"type": "array", "items": {"type": "string"}},
    "entrypoints_traced": {"type": "array", "items": {"type": "string"}},
    "sinks_reviewed": {"type": "array", "items": {"type": "string"}},
    "mitigations_checked": {"type": "array", "items": {"type": "string"}},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "hardening_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {"$ref": "exploration-context.schema.json#/$defs/value"},
        "maxProperties": 64,
        "propertyNames": {"type": "string", "maxLength": 128},
        "required": ["title", "description", "evidence_refs"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "positive_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {"$ref": "exploration-context.schema.json#/$defs/value"},
        "maxProperties": 64,
        "propertyNames": {"type": "string", "maxLength": 128},
        "required": ["title", "description", "evidence_refs"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "rabbit_holes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id", "question_id", "subsystem", "attack_class_id", "surface_ids", "threat_ids",
          "asset_ids", "attacker", "entrypoint_ids", "boundary_ids",
          "security_question", "stop_conditions", "priority", "reason",
          "expected_added_value", "files", "evidence_refs"
        ],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
          "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
          "subsystem": {"type": "string", "minLength": 1},
          "attack_class_id": {"type": "string", "minLength": 1},
          "surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "threat_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "attacker": {"type": "string", "minLength": 1},
          "entrypoint_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "boundary_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "security_question": {"type": "string", "minLength": 12},
          "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "reason": {"type": "string", "minLength": 1},
          "expected_added_value": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "wishlist_items": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "reason", "next_action", "evidence_refs", "missing_fact"],
      "properties": {
        "optional_support": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/optionalSupport"}},
        "outcome": {"enum": ["established", "contradicted", "locally_unresolved", "externally_blocked", "budget_deferred", "execution_failed"]},
        "reason": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing_fact": {"type": "string"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["objective_id", "question_id", "established_facts", "contradicted_paths", "remaining_question", "files_reviewed", "next_step", "expected_results"],
      "properties": {
        "objective_id": {"type": "string", "pattern": "^OBJ-[A-F0-9]{12}$"},
        "question_id": {"type": "string", "pattern": "^Q-[A-F0-9]{12}$"},
        "established_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contradicted_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "remaining_question": {"type": "string"},
        "files_reviewed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_step": {"type": "string"},
        "expected_results": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
