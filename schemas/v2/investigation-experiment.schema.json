{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Investigative Experiment",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_id", "owner_phase", "owner_ref", "obligation", "static_limitation", "behavior", "supports", "contradicts", "input_refs", "dependencies", "execution_policy", "interpretation_boundary", "command", "support_exit_code", "contradict_exit_code"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"},
    "owner_phase": {"enum": ["sast", "intrusion"]},
    "owner_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "obligation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "static_limitation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "behavior": {"type": "string", "minLength": 1, "maxLength": 1000},
    "supports": {"type": "string", "minLength": 1, "maxLength": 1000},
    "contradicts": {"type": "string", "minLength": 1, "maxLength": 1000},
    "input_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "dependencies": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "execution_policy": {"const": "safe_offline_disposable"},
    "interpretation_boundary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "command": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "support_exit_code": {"const": 0},
    "contradict_exit_code": {"const": 1}
  }
}
