{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Recon Worker Research",
  "type": "object",
  "additionalProperties": {"$ref": "exploration-context.schema.json#/$defs/value"},
  "maxProperties": 64,
  "propertyNames": {"type": "string", "maxLength": 128},
  "required": ["schema_version", "worker", "status", "started_at", "completed_at", "observations", "warnings", "errors", "provenance"],
  "properties": {
    "provenance": {"type": "object", "additionalProperties": false, "required": ["actor", "selector", "artifact_ref"], "properties": {"actor": {"type": "string", "minLength": 1}, "selector": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}}},
    "attack_paths": {"$ref": "security-surfaces.schema.json#/properties/attack_paths"},
    "schema_version": {"const": "2.0"},
    "worker": {"enum": ["overview", "trust-boundaries", "input-surfaces"]},
    "status": {"enum": ["ok", "degraded", "failed"]},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {"$ref": "exploration-context.schema.json#/$defs/value"},
        "maxProperties": 64,
        "propertyNames": {"type": "string", "maxLength": 128},
        "required": ["id", "category", "title", "description", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "category": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
