{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Recon Worker Research",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker", "status", "observations", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "worker": {"enum": ["overview", "trust-boundaries", "input-surfaces"]},
    "status": {"enum": ["ok", "degraded", "failed"]},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "description", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "category": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
