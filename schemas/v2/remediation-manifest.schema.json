{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V2 Linked Remediation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "remediation_id", "source_run_id",
    "repo_id", "source_scan_ref", "source_report_ref", "depth",
    "target_fingerprint", "report_sha256", "final_findings_sha256",
    "remediation_contract_sha256", "model", "status", "attempts",
    "recovery_count", "recovery_history", "created_at", "updated_at",
    "completed_at", "artifact", "artifact_sha256", "error"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_kind": {"const": "linked-remediation"},
    "remediation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "source_run_id": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string", "minLength": 1},
    "source_scan_ref": {"type": "string", "pattern": "^scans/"},
    "source_report_ref": {"const": "report/security-report.json"},
    "depth": {"enum": ["quick", "balanced", "full"]},
    "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "final_findings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "remediation_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["initialized", "running", "ok", "degraded", "failed"]},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 2},
    "recovery_count": {"type": "integer", "minimum": 0},
    "recovery_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["generation", "recovered_at", "reason"],
        "properties": {
          "generation": {"type": "integer", "minimum": 1},
          "recovered_at": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": ["string", "null"]},
    "artifact": {"type": ["string", "null"]},
    "artifact_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "error": {"type": ["string", "null"], "maxLength": 1000}
  }
}
