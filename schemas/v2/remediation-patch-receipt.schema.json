{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V2 Remediation Patch Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "remediation_id", "finding_id", "status", "patch_ref",
    "patch_sha256", "target_fingerprint", "changed_files", "apply_check",
    "secret_scan", "production_only", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "remediation_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "pattern": "^F-[0-9]{3}$"},
    "status": {"const": "ok"},
    "patch_ref": {"type": "string", "pattern": "^patches/F-[0-9]{3}\\.patch$"},
    "patch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "changed_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "apply_check": {"const": "ok"},
    "secret_scan": {"const": "ok"},
    "production_only": {"const": true},
    "created_at": {"type": "string", "minLength": 1}
  }
}
