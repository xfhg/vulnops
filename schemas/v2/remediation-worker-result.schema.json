{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V2 Per-Finding Remediation Worker Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "remediation_id", "finding_id", "status", "summary",
    "addressed_locations", "changed_files", "limitations", "errors", "model"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "remediation_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "pattern": "^F-[0-9]{3}$"},
    "status": {"enum": ["candidate", "manual_required", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "addressed_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "reason"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model": {"type": "string", "minLength": 1}
  }
}
