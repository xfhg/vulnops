{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow", "run_id", "repo_id", "repository", "commit",
    "depth", "status", "scan_base", "created_at", "updated_at",
    "target_fingerprint", "model", "model_roles", "verifier_model", "model_diversity", "reproduction_mode",
    "phases"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "workflow": {"const": "canonical-redteam-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "minLength": 1},
    "depth": {"enum": ["quick", "balanced", "full"]},
    "status": {"enum": ["initialized", "running", "degraded", "failed", "complete"]},
    "scan_base": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "model_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "task", "slow", "smol"],
      "properties": {
        "orchestrator": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "slow": {"type": "string", "minLength": 1},
        "smol": {"type": "string", "minLength": 1}
      }
    },
    "verifier_model": {"type": "string", "minLength": 1},
    "model_diversity": {"type": "boolean"},
    "reproduction_mode": {"enum": ["off", "safe"]},
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recon", "tool-collection", "sast", "campaign-planning",
        "intrusion", "synthesis", "final-verification", "report"
      ],
      "properties": {
        "recon": {"$ref": "#/$defs/phaseStatus"},
        "tool-collection": {"$ref": "#/$defs/phaseStatus"},
        "sast": {"$ref": "#/$defs/phaseStatus"},
        "campaign-planning": {"$ref": "#/$defs/phaseStatus"},
        "intrusion": {"$ref": "#/$defs/phaseStatus"},
        "synthesis": {"$ref": "#/$defs/phaseStatus"},
        "final-verification": {"$ref": "#/$defs/phaseStatus"},
        "report": {"$ref": "#/$defs/phaseStatus"}
      }
    }
  },
  "$defs": {
    "phaseStatus": {
      "enum": ["pending", "running", "ok", "degraded", "failed", "skipped"]
    }
  }
}
