{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow", "run_id", "repo_id", "repository", "commit",
    "depth", "status", "scan_base", "created_at", "updated_at",
    "repositories", "repository_inventory_verified",
    "sast_budget", "intrusion_budget", "experiment_budget", "model", "model_routing", "verifier_model", "model_diversity", "reproduction_mode",
    "codegraph_mode", "network", "offline_package",
    "phases", "recovery_count", "recovery_history"
  ],
  "allOf": [{
    "if": {"properties": {"phases": {"required": ["gap-exploration"]}}},
    "then": {"required": ["gap_exploration_budget"]}
  }],
  "properties": {
    "schema_version": {"const": "2.0"},
    "workflow": {"const": "canonical-redteam-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "minLength": 1},
    "depth": {"enum": ["quick", "balanced", "full"]},
    "status": {"enum": ["incomplete", "complete"]},
    "scan_base": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "minLength": 1},
    "error": {"type": ["string", "null"], "maxLength": 1000},
    "attempt_id": {"type": "string", "minLength": 1},
    "assessment_id": {"type": ["string", "null"]},
    "assessment_scopes": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentScopes"},
    "phase_attempts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "attempt_contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["repositories", "model_routing", "source_root", "started_at"],
        "properties": {
          "source_view": {"enum": ["base", "derived", "base/derived"]},
          "patch_ref": {"type": ["string", "null"]},
          "repositories": {"type": "array", "items": {"type": "object"}},
          "model_routing": {"type": "object"},
          "source_root": {"type": ["string", "null"]},
          "gap_exploration_budget": {"$ref": "gap-exploration-budget.schema.json"},
          "started_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "remote_url", "commit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "remote_url": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "minLength": 1}
        }
      }
    },
    "repository_inventory_verified": {"type": "boolean"},
    "gap_exploration_budget": {"$ref": "gap-exploration-budget.schema.json"},
    "sast_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "max_hunt_tasks", "max_hunt_questions", "max_gapfill_rounds", "max_attempts", "context_packet_bytes"],
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_hunt_tasks": {"type": "integer", "minimum": 1},
        "max_hunt_questions": {"type": "integer", "minimum": 1},
        "max_gapfill_rounds": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "context_packet_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "intrusion_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuation_rounds", "continuation_tasks", "graph_followups"],
      "properties": {
        "continuation_rounds": {"type": "integer", "minimum": 0, "maximum": 3},
        "continuation_tasks": {"type": "integer", "minimum": 0, "maximum": 24},
        "graph_followups": {"type": "integer", "minimum": 0, "maximum": 24}
      }
    },
    "experiment_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_experiments", "max_concurrency", "timeout_seconds", "cpu_seconds", "memory_mb", "max_processes", "max_output_kb"],
      "properties": {
        "max_experiments": {"type": "integer", "minimum": 1},
        "max_concurrency": {"const": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "max_processes": {"type": "integer", "minimum": 1},
        "max_output_kb": {"type": "integer", "minimum": 1}
      }
    },
    "model": {"type": "string", "minLength": 1},
    "model_routing": {"$ref": "model-routing.schema.json#/$defs/audit"},
    "verifier_model": {"type": "string", "minLength": 1},
    "model_diversity": {"type": "boolean"},
    "reproduction_mode": {"enum": ["off", "safe"]},
    "codegraph_mode": {"enum": ["enabled", "disabled"]},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_egress", "backend", "enforced", "limitation"],
      "properties": {
        "agent_egress": {"enum": ["enforced", "policy_only"]},
        "backend": {"enum": ["bubblewrap-unshare-net", "none"]},
        "enforced": {"type": "boolean"},
        "limitation": {"type": ["string", "null"]}
      }
    },
    "offline_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "platform", "release", "osv_snapshot", "osv_lock_sha256"],
      "properties": {
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "platform": {"enum": ["linux_amd64", "darwin_arm64"]},
        "release": {"type": "boolean"},
        "osv_snapshot": {"type": "string", "minLength": 1},
        "osv_lock_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "recovery_count": {"type": "integer", "minimum": 0},
    "recovery_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/recoveryEvent"}
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recon", "tool-collection", "sast", "campaign-planning",
        "intrusion", "synthesis", "final-verification", "report"
      ],
      "properties": {
        "recon": {"$ref": "#/$defs/phaseStatus"},
        "tool-collection": {"$ref": "#/$defs/phaseStatus"},
        "sast": {"$ref": "#/$defs/phaseStatus"},
        "campaign-planning": {"$ref": "#/$defs/phaseStatus"},
        "intrusion": {"$ref": "#/$defs/phaseStatus"},
        "gap-exploration": {"$ref": "#/$defs/phaseStatus"},
        "synthesis": {"$ref": "#/$defs/phaseStatus"},
        "final-verification": {"$ref": "#/$defs/phaseStatus"},
        "report": {"$ref": "#/$defs/phaseStatus"}
      }
    }
  },
  "$defs": {
    "phaseName": {
      "enum": ["recon", "tool-collection", "sast", "campaign-planning", "intrusion", "gap-exploration", "synthesis", "final-verification", "report"]
    },
    "recoveryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "recovered_at", "rollback_phase", "retained_phases", "cleared_phases", "reason"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "recovered_at": {"type": "string", "minLength": 1},
        "rollback_phase": {"$ref": "#/$defs/phaseName"},
        "retained_phases": {"type": "array", "items": {"$ref": "#/$defs/phaseName"}, "uniqueItems": true},
        "cleared_phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phaseName"}, "uniqueItems": true},
        "retained_work": {"type": "array", "items": {"enum": ["sast", "intrusion", "gap-exploration", "synthesis", "final-verification"]}, "uniqueItems": true},
        "from_contract_sha256": {},
        "to_contract_sha256": {},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "reason", "archive_path"],
          "properties": {
            "phase": {"const": "sast"},
            "kind": {"const": "source-evidence-errors"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "archive_path": {"type": "string", "pattern": "^recovery-archives/generation-[1-9][0-9]*$"},
            "receipt_sha256": {},
            "source_error_count": {"type": "integer", "minimum": 1},
            "source_errors": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    },
    "phaseStatus": {
      "enum": ["pending", "running", "ok", "degraded", "failed", "skipped"]
    }
  }
}
