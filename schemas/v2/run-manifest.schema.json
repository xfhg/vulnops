{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow", "run_id", "repo_id", "repository", "commit",
    "depth", "status", "scan_base", "created_at", "updated_at",
    "target_fingerprint", "harness_contract_sha256", "sast_budget", "model", "model_roles", "verifier_model", "model_diversity", "reproduction_mode",
    "network", "offline_package",
    "phases", "phase_seals", "recovery_count", "recovery_history"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "workflow": {"const": "canonical-redteam-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "minLength": 1},
    "depth": {"enum": ["quick", "balanced", "full"]},
    "status": {"enum": ["initialized", "running", "degraded", "failed", "complete"]},
    "scan_base": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "harness_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sast_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "max_hunt_tasks", "max_hunt_questions", "max_gapfill_rounds", "max_attempts", "context_packet_bytes"],
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_hunt_tasks": {"type": "integer", "minimum": 1},
        "max_hunt_questions": {"type": "integer", "minimum": 1},
        "max_gapfill_rounds": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "context_packet_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "model": {"type": "string", "minLength": 1},
    "model_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "task", "slow", "smol"],
      "properties": {
        "orchestrator": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "slow": {"type": "string", "minLength": 1},
        "smol": {"type": "string", "minLength": 1}
      }
    },
    "verifier_model": {"type": "string", "minLength": 1},
    "model_diversity": {"type": "boolean"},
    "reproduction_mode": {"enum": ["off", "safe"]},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_egress", "backend", "enforced", "limitation"],
      "properties": {
        "agent_egress": {"enum": ["enforced", "policy_only"]},
        "backend": {"enum": ["bubblewrap-unshare-net", "none"]},
        "enforced": {"type": "boolean"},
        "limitation": {"type": ["string", "null"]}
      }
    },
    "offline_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "platform", "release", "osv_snapshot", "osv_lock_sha256"],
      "properties": {
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "platform": {"enum": ["linux_amd64", "darwin_arm64"]},
        "release": {"type": "boolean"},
        "osv_snapshot": {"type": "string", "minLength": 1},
        "osv_lock_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "recovery_count": {"type": "integer", "minimum": 0},
    "recovery_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/recoveryEvent"}
    },
    "phase_seals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recon": {"$ref": "#/$defs/phaseSeal"},
        "tool-collection": {"$ref": "#/$defs/phaseSeal"},
        "sast": {"$ref": "#/$defs/phaseSeal"},
        "campaign-planning": {"$ref": "#/$defs/phaseSeal"},
        "intrusion": {"$ref": "#/$defs/phaseSeal"},
        "synthesis": {"$ref": "#/$defs/phaseSeal"},
        "final-verification": {"$ref": "#/$defs/phaseSeal"},
        "report": {"$ref": "#/$defs/phaseSeal"}
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recon", "tool-collection", "sast", "campaign-planning",
        "intrusion", "synthesis", "final-verification", "report"
      ],
      "properties": {
        "recon": {"$ref": "#/$defs/phaseStatus"},
        "tool-collection": {"$ref": "#/$defs/phaseStatus"},
        "sast": {"$ref": "#/$defs/phaseStatus"},
        "campaign-planning": {"$ref": "#/$defs/phaseStatus"},
        "intrusion": {"$ref": "#/$defs/phaseStatus"},
        "synthesis": {"$ref": "#/$defs/phaseStatus"},
        "final-verification": {"$ref": "#/$defs/phaseStatus"},
        "report": {"$ref": "#/$defs/phaseStatus"}
      }
    }
  },
  "$defs": {
    "phaseName": {
      "enum": ["recon", "tool-collection", "sast", "campaign-planning", "intrusion", "synthesis", "final-verification", "report"]
    },
    "phaseSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_sha256", "artifact_sha256", "file_count", "sealed_at", "validation"],
      "properties": {
        "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "file_count": {"type": "integer", "minimum": 1},
        "sealed_at": {"type": "string", "minLength": 1},
        "validation": {"enum": ["current_gate", "retained_prior_gate"]}
      }
    },
    "recoveryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "recovered_at", "rollback_phase", "retained_phases", "cleared_phases", "from_contract_sha256", "to_contract_sha256", "reason"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "recovered_at": {"type": "string", "minLength": 1},
        "rollback_phase": {"$ref": "#/$defs/phaseName"},
        "retained_phases": {"type": "array", "items": {"$ref": "#/$defs/phaseName"}, "uniqueItems": true},
        "cleared_phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phaseName"}, "uniqueItems": true},
        "from_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "to_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "phaseStatus": {
      "enum": ["pending", "running", "ok", "degraded", "failed", "skipped"]
    }
  }
}
