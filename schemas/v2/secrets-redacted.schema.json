{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps v2 Fully Redacted Secret Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "candidates"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "tool": {"enum": ["poltergeist", "grep-fallback"]},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "classification", "severity", "file", "line", "redacted_value", "evidence_refs", "raw_ref", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "type": {"enum": ["api-key", "password", "private-key", "token", "connection-string", "credential", "unknown"]},
          "classification": {"enum": ["confirmed", "likely", "false-positive", "deprecated", "candidate"]},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "redacted_value": {"const": "<redacted>"},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "raw_ref": {"type": "string", "minLength": 1},
          "source": {"enum": ["poltergeist", "grep-fallback"]}
        }
      }
    }
  }
}
