{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Redacted Poltergeist Candidates",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tool", "match_count", "candidate_count", "candidates"],
  "properties": {
    "schema_version": {"const": "2.0"}, "tool": {"const": "poltergeist"},
    "match_count": {"type": "integer", "minimum": 0}, "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "rule_id", "classification", "file", "line", "redaction", "exposure_path", "validity"],
      "properties": {
        "id": {"type": "string", "pattern": "^SEC-[a-f0-9]{16}$"}, "type": {"type": "string", "minLength": 1}, "rule_id": {"type": "string", "minLength": 1},
        "classification": {"const": "candidate"}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1},
        "redaction": {"const": "<redacted>"}, "exposure_path": {"type": "string", "minLength": 1}, "validity": {"enum": ["unknown", "confirmed_format", "likely", "revoked"]}
      }
    }}
  }
}
