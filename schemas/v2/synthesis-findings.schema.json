{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnOps V5 Synthesized Findings",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "findings", "objective_assessments"],
  "properties": {
    "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
    "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 1},
    "objective_assessments": {"type":"array","maxItems":2048,"items":{"$ref":"#/$defs/objectiveAssessment"}},
    "prior_run_reconciliation": {"type": "array", "items": {"$ref": "#/$defs/reconciliation"}},
    "input_claims": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/inputClaim"}},
    "non_promoted": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/nonPromoted"}},
    "unreviewed": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/unreviewed"}},
    "evidence_quality": {"$ref": "evidence-accounting.schema.json#/$defs/quality"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
"component": {"type":"object","additionalProperties":false,"required":["id","name","repository","locations","entrypoints","service","evidence_refs"],"properties":{"id":{"type":"string","minLength":1,"maxLength":512},"name":{"type":"string","minLength":1,"maxLength":512},"repository":{"type":"string","minLength":1,"maxLength":512},"locations":{"type":"array","items":{"$ref":"#/$defs/location"},"minItems":1,"maxItems":64},"entrypoints":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64},"service":{"type":"object","additionalProperties":false,"required":["name","binding","evidence_refs","limitation"],"properties":{"name":{"type":["string","null"],"minLength":1,"maxLength":512},"binding":{"enum":["established","unknown"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true},"limitation":{"type":"string","maxLength":8000}}},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},
"exploitationStep": {"type":"object","additionalProperties":false,"required":["id","action","controlled_input","component_ids","why_it_works","expected_result","evidence_status","evidence_refs","observed_result","observation_refs","example_ids","primitive_ids"],"properties":{"id":{"type":"string","minLength":1,"maxLength":512},"action":{"type":"string","minLength":1,"maxLength":8000},"controlled_input":{"type":"string","minLength":1,"maxLength":8000},"component_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"why_it_works":{"type":"string","minLength":1,"maxLength":8000},"expected_result":{"type":"string","minLength":1,"maxLength":8000},"evidence_status":{"enum":["source_established","observed_contained","environment_required"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"observed_result":{"type":["string","null"],"minLength":1,"maxLength":8000},"observation_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true},"example_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true},"primitive_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true}}},
"technicalExample": {"type":"object","additionalProperties":false,"required":["id","kind","content","evidence_refs","substitutions","execution_status","observation_refs"],"properties":{"id":{"type":"string","minLength":1,"maxLength":512},"kind":{"enum":["source","request","command","configuration"]},"content":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"substitutions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["original","replacement","reason"],"properties":{"original":{"type":"string","minLength":1,"maxLength":512},"replacement":{"type":"string","minLength":1,"maxLength":512},"reason":{"type":"string","minLength":1,"maxLength":8000}}},"minItems":0,"maxItems":64},"execution_status":{"enum":["not_executed","observed_contained"]},"observation_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true}}},
"remediation": {"type":"object","additionalProperties":false,"required":["actions","containment","detection","limitations","verification_checks"],"properties":{"actions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","component_ids","locations","change","rationale","breaks_steps","evidence_refs","example_ids"],"properties":{"id":{"type":"string","minLength":1,"maxLength":512},"component_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"locations":{"type":"array","items":{"$ref":"#/$defs/location"},"minItems":1,"maxItems":64},"change":{"type":"string","minLength":1,"maxLength":8000},"rationale":{"type":"string","minLength":1,"maxLength":8000},"breaks_steps":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"example_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true}}},"minItems":1,"maxItems":64},"containment":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["description","component_ids","evidence_refs"],"properties":{"description":{"type":"string","minLength":1,"maxLength":8000},"component_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},"minItems":0,"maxItems":64},"detection":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["description","component_ids","evidence_refs"],"properties":{"description":{"type":"string","minLength":1,"maxLength":8000},"component_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},"minItems":0,"maxItems":64},"limitations":{"type":"array","items":{"type":"string","minLength":1,"maxLength":8000},"minItems":0,"maxItems":64},"verification_checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","description","attack_expected","legitimate_expected","status","evidence_refs"],"properties":{"id":{"type":"string","minLength":1,"maxLength":512},"description":{"type":"string","minLength":1,"maxLength":8000},"attack_expected":{"type":"string","minLength":1,"maxLength":8000},"legitimate_expected":{"type":"string","minLength":1,"maxLength":8000},"status":{"enum":["proposed","executed"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true}}},"minItems":1,"maxItems":64}}},
"objectiveAssessment": {"type":"object","additionalProperties":false,"required":["objective_id","success_condition","status","finding_ids","question_outcomes","reason","remaining_obligations","evidence_refs"],"properties":{"assessment_context":{"$ref":"evidence-accounting.schema.json#/$defs/assessmentContext"},"objective_id":{"type":"string","minLength":1,"maxLength":512},"success_condition":{"type":"string","minLength":1,"maxLength":8000},"status":{"enum":["achieved","unresolved"]},"finding_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true},"question_outcomes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["objective_id","question_id","outcome","reason","evidence_refs","missing_fact","next_action","owner_ref"],"properties":{"objective_id":{"type":"string","minLength":1,"maxLength":512},"question_id":{"type":"string","minLength":1,"maxLength":512},"outcome":{"enum":["established","contradicted","locally_unresolved","externally_blocked","budget_deferred","execution_failed","not_investigated","redundant"]},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true},"missing_fact":{"type":"string","maxLength":8000},"next_action":{"type":"string","maxLength":8000},"owner_ref":{"type":"string","minLength":1,"maxLength":512}}},"minItems":0,"maxItems":2048},"reason":{"type":"string","minLength":1,"maxLength":8000},"remaining_obligations":{"type":"array","items":{"type":"string","minLength":1,"maxLength":8000},"minItems":0,"maxItems":2048},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":0,"maxItems":64,"uniqueItems":true}}},
"dossierReview": {"type":"object","additionalProperties":false,"required":["dossier_sha256","affected_scope","exploitation","technical_examples","impact_limits","remediation"],"properties":{"dossier_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"affected_scope":{"type":"object","additionalProperties":false,"required":["disposition","reason","evidence_refs"],"properties":{"disposition":{"enum":["supported","corrected","unresolved"]},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},"exploitation":{"type":"object","additionalProperties":false,"required":["disposition","reason","evidence_refs"],"properties":{"disposition":{"enum":["supported","corrected","unresolved"]},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},"technical_examples":{"type":"object","additionalProperties":false,"required":["disposition","reason","evidence_refs"],"properties":{"disposition":{"enum":["supported","corrected","unresolved"]},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},"impact_limits":{"type":"object","additionalProperties":false,"required":["disposition","reason","evidence_refs"],"properties":{"disposition":{"enum":["supported","corrected","unresolved"]},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},"remediation":{"type":"object","additionalProperties":false,"required":["disposition","reason","evidence_refs"],"properties":{"disposition":{"enum":["supported","corrected","unresolved"]},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}}}},
"objectiveResult": {"type":"object","additionalProperties":false,"required":["objective_id","success_condition","satisfied","reason","evidence_refs"],"properties":{"objective_id":{"type":"string","minLength":1,"maxLength":512},"success_condition":{"type":"string","minLength":1,"maxLength":8000},"satisfied":{"type":"boolean"},"reason":{"type":"string","minLength":1,"maxLength":8000},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"minItems":1,"maxItems":64,"uniqueItems":true}}},
    "modelSelector": {"type": "string", "pattern": "^[^/\\s]+/[^\\s]+:(off|minimal|low|medium|high|xhigh|max|auto)$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["actor", "selector", "artifact_ref"], "properties": {"actor": {"type": "string", "pattern": "^vulnops-[a-z]+(?:-[a-z]+)*$"}, "selector": {"$ref": "#/$defs/modelSelector"}, "artifact_ref": {"type": "string", "minLength": 1}}},
    "contributors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/provenance"}},
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["prior_report_ref", "prior_finding_id", "status", "reason", "evidence_refs", "current_finding_ids", "applicability"], "properties": {"prior_report_ref": {"type": "string", "minLength": 1}, "prior_finding_id": {"type": "string", "minLength": 1}, "status": {"enum": ["revalidated", "contradicted", "superseded", "not_revisited"]}, "reason": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "current_finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "applicability": {"type": "object", "additionalProperties": false, "required": ["source", "policy", "deployment"], "properties": {"source": {"type": "string", "minLength": 1}, "policy": {"type": "string", "minLength": 1}, "deployment": {"type": "string", "minLength": 1}}}}},
    "location": {"type": "object", "additionalProperties": false, "required": ["file", "line", "scope", "mechanism"], "properties": {"file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "scope": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1}}},
    "trace": {"type": "object", "additionalProperties": false, "required": ["kind", "file", "line", "scope", "description"], "properties": {"kind": {"enum": ["entrypoint", "propagation", "sink"]}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "scope": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "sourceRef": {"type": "object", "additionalProperties": false, "required": ["kind", "source_id", "artifact_ref"], "properties": {"kind": {"enum": ["recon", "sca", "secret", "sast", "campaign", "intrusion", "reproduction", "gap-exploration"]}, "source_id": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}}},
    "primitiveStep": {"type": "object", "additionalProperties": false, "required": ["primitive_id", "input_capability", "output_capability", "boundary_crossed", "evidence_refs"], "properties": {"primitive_id": {"type": "string", "minLength": 1}, "input_capability": {"type": "string", "minLength": 1}, "output_capability": {"type": "string", "minLength": 1}, "boundary_crossed": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}}},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "finding_kind", "origin", "title", "category", "severity", "risk_score", "confidence", "status", "attacker", "intended_behavior", "root_causes", "trace", "conditions", "impact", "remediation", "verification", "contributors", "primitive_steps", "transitions", "source_refs", "graph_receipt_refs", "closure_rationale", "dependency", "secret", "objective_ids", "attack_summary", "affected_components", "exploitation", "technical_examples", "impact_limits"],
      "properties": {
        "assessment_context": {"$ref": "evidence-accounting.schema.json#/$defs/assessmentContext"},
"objective_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}, "minItems": 1, "maxItems": 64, "uniqueItems": true},
"attack_summary": {"type": "string", "minLength": 1, "maxLength": 8000},
"affected_components": {"type": "array", "items": {"$ref": "#/$defs/component"}, "minItems": 1, "maxItems": 64},
"exploitation": {"type": "object", "additionalProperties": false, "required": ["rationale", "setup", "steps"], "properties": {"rationale": {"type": "string", "minLength": 1, "maxLength": 8000}, "setup": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 8000}, "minItems": 0, "maxItems": 64}, "steps": {"type": "array", "items": {"$ref": "#/$defs/exploitationStep"}, "minItems": 1, "maxItems": 64}}},
"technical_examples": {"type": "array", "items": {"$ref": "#/$defs/technicalExample"}, "minItems": 0, "maxItems": 64},
"impact_limits": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 8000}, "minItems": 0, "maxItems": 64},
        "id": {"type": "string", "pattern": "^F-[0-9]{3}$"}, "finding_kind": {"enum": ["code", "dependency", "secret", "chain"]},
        "origin": {"enum": ["standalone_known", "known_impact_expansion", "composite_chain", "independent_discovery", "cross_evidence_discovery"]},
        "title": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
        "risk_score": {"type": "integer", "minimum": 0, "maximum": 100}, "confidence": {"enum": ["low", "medium", "high"]}, "status": {"enum": ["verified", "needs_environment"]},
        "attacker": {"type": "object", "additionalProperties": false, "required": ["perspective", "starting_access", "boundary_crossed"], "properties": {"perspective": {"type": "string", "minLength": 1}, "starting_access": {"type": "string", "minLength": 1}, "boundary_crossed": {"type": "string", "minLength": 1}}},
        "intended_behavior": {"type": "string", "minLength": 1}, "root_causes": {"type": "array", "items": {"$ref": "#/$defs/location"}, "minItems": 1},
        "trace": {"type": "array", "items": {"$ref": "#/$defs/trace"}, "minItems": 2}, "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "impact": {"type":"string","minLength":1,"maxLength":8000}, "remediation": {"$ref":"#/$defs/remediation"},
        "verification": {"type": "object", "additionalProperties": false, "required": ["level", "actor", "model", "source_validation_refs", "reproduction_ref"], "properties": {"level": {"enum": ["source_verified", "dynamic_verified", "environment_required"]}, "actor": {"const": "vulnops-synthesis"}, "model": {"$ref": "#/$defs/modelSelector"}, "source_validation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "reproduction_ref": {"type": ["string", "null"]}}},
        "contributors": {"$ref": "#/$defs/contributors"},
        "optional_support": {"type": "array", "items": {"$ref": "evidence-accounting.schema.json#/$defs/optionalSupport"}},
        "primitive_steps": {"type": "array", "items": {"$ref": "#/$defs/primitiveStep"}}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}, "minItems": 1},
        "transitions": {"type": "array", "items": {"$ref": "intrusion-results.schema.json#/$defs/transition"}},
        "graph_receipt_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "closure_rationale": {"type": "string", "minLength": 1},
        "dependency": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["advisory_id", "package", "installed_version", "affected_use", "reachability"], "properties": {"advisory_id": {"type": "string", "minLength": 1}, "package": {"type": "string", "minLength": 1}, "installed_version": {"type": "string", "minLength": 1}, "affected_use": {"type": "string", "minLength": 1}, "reachability": {"enum": ["reachable", "not_reachable", "unknown"]}}}]},
        "secret": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["type", "file", "line", "redaction", "exposure_path", "validity"], "properties": {"type": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "redaction": {"const": "<redacted>"}, "exposure_path": {"type": "string", "minLength": 1}, "validity": {"enum": ["confirmed_format", "likely", "unknown", "revoked"]}}}]}
      }
    }
  }
}
