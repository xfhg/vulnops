{
  "name": "@vulnops/stake",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "description": "VulnOps @stake \u2014 local assessment intelligence and attack-path exploration",
  "bin": {
    "stake": "./dist-server/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild server/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/cli.js",
    "start": "node dist-server/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:web": "tsc --noEmit && vite build --mode browser",
    "dev:web": "vite --mode browser --host 127.0.0.1",
    "test:e2e:web": "playwright test --config playwright.browser.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "@xyflow/react": "12.12.1",
    "@zip.js/zip.js": "2.24.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "0.12.1",
    "idb": "8.0.4",
    "lucide-react": "1.68.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.18.0",
    "recharts": "3.10.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
